# 接口注释：
# 这是 Docker 部署后端服务建议使用的环境变量模板。
# 生产环境请复制成你自己的私有 env 文件，再把真实密钥填进去。

# 这是 Docker 后端统一使用的主大模型接口地址。
# 配置方法：填写兼容 OpenAI API 的根地址，通常要以 `/v1` 结尾。
ISOFTDEVAGENTS_LLM_BASE_URL=https://api.modelverse.cn/v1

# 这是 Docker 后端统一使用的主大模型名称。
# 配置方法：填写服务商支持的模型名，例如 `gpt-5.4`。
ISOFTDEVAGENTS_LLM_MODEL=gpt-5.4

# 这是 Docker 后端统一使用的主大模型密钥。
# 配置方法：替换成你自己的真实密钥。
ISOFTDEVAGENTS_LLM_API_KEY=replace-with-your-key

# 这是是否启用 Requirements Agent。
# 配置方法：`1` 表示启用，`0` 表示禁用。
ISOFTDEVAGENTS_ENABLE_REAGENT=1

# 这是是否启用 Architecture Agent。
# 配置方法：`1` 表示启用，`0` 表示禁用。
ISOFTDEVAGENTS_ENABLE_ARCH_AGENT=1

# 这是是否启用 UI Agent。
# 配置方法：`1` 表示启用，`0` 表示禁用。
ISOFTDEVAGENTS_ENABLE_UI_AGENT=1

# 这是是否启用 Coding Agent。
# 配置方法：`1` 表示启用，`0` 表示禁用。
ISOFTDEVAGENTS_ENABLE_CODING_AGENT=1

# 这是是否启用 Test Agent。
# 配置方法：`1` 表示启用，`0` 表示禁用。
ISOFTDEVAGENTS_ENABLE_TEST_AGENT=1

# 这是 Requirements Agent 在 Docker 里使用的 Python 路径。
# 配置方法：通常留空，让容器自己用镜像内部环境；只有你自定义运行时才需要填写。
ISOFTDEVAGENTS_REAGENT_PYTHON_BIN=

# 这是 Requirements Agent 在 Docker 里使用的 site-packages 路径。
# 配置方法：通常留空；只有你自定义运行时才需要填写。
ISOFTDEVAGENTS_REAGENT_SITE_PACKAGES=

# 这是 Architecture Agent 在 Docker 里使用的 Python 路径。
# 配置方法：通常留空，让容器自己用镜像内部环境；只有你自定义运行时才需要填写。
ISOFTDEVAGENTS_ARCH_AGENT_PYTHON_BIN=

# 这是 Coding Agent 在 Docker 里使用的 Python 路径。
# 配置方法：通常留空；只有你自定义运行时才需要填写。
ISOFTDEVAGENTS_CODING_AGENT_PYTHON_BIN=

# 这是 Coding Agent 在 Docker 里使用的 site-packages 路径。
# 配置方法：通常留空；只有你自定义运行时才需要填写。
ISOFTDEVAGENTS_CODING_AGENT_SITE_PACKAGES=

# 这是 Test Agent 在 Docker 里使用的 site-packages 路径。
# 配置方法：通常留空；只有你自定义运行时才需要填写。
ISOFTDEVAGENTS_TEST_AGENT_SITE_PACKAGES=

# 这是所有 Agent 共用的默认超时时间，单位是秒。
# 配置方法：如果你希望所有 Agent 都更耐等，可以把它调大。
ISOFTDEVAGENTS_AGENT_TIMEOUT=3600

# 这是分析阶段专用超时时间，单位是秒。
# 配置方法：如果需求分析经常慢，可以单独调大。
ISOFTDEVAGENTS_ANALYSIS_AGENT_TIMEOUT=3600

# 这是生成阶段专用超时时间，单位是秒。
# 配置方法：如果主生成流程经常慢，可以单独调大。
ISOFTDEVAGENTS_GENERATION_AGENT_TIMEOUT=3600

# 这是架构 Agent 专用超时时间，单位是秒。
# 配置方法：如果架构生成经常超时，可以单独调大。
ISOFTDEVAGENTS_ARCHITECTURE_AGENT_TIMEOUT=3600

# 这是 UI Agent 专用超时时间，单位是秒。
# 配置方法：如果 UI 生成经常超时，可以单独调大。
ISOFTDEVAGENTS_UI_AGENT_TIMEOUT=3600

# 这是 Coding Agent 专用超时时间，单位是秒。
# 配置方法：如果代码生成经常超时，可以单独调大。
ISOFTDEVAGENTS_CODING_AGENT_TIMEOUT=3600

# 这是 Test Agent 专用超时时间，单位是秒。
# 配置方法：如果测试生成经常超时，可以单独调大。
ISOFTDEVAGENTS_TEST_AGENT_TIMEOUT=3600

# 这是零残留开关。
# 配置方法：`1` 表示“成功持久化后尽量删除本地文件”，`0` 表示保留本地文件。
ISOFTDEVAGENTS_DELETE_LOCAL_FILES_AFTER_PERSIST=0

# 这是是否把 Agent 标准输出和标准错误打印到控制台。
# 配置方法：Docker 本地排查建议设成 `1`。
ISOFTDEVAGENTS_AGENT_DEBUG_STDIO=1

# 这是是否记录 LLM 输入输出调试日志。
# 配置方法：`1` 表示记录，`0` 表示不记录。
ISOFTDEVAGENTS_AGENT_DEBUG_LLM_IO=1

# 这是是否把 LLM 调试日志写入文件。
# 配置方法：`1` 表示写文件，`0` 表示不写文件。
ISOFTDEVAGENTS_AGENT_DEBUG_LLM_LOG_TO_FILE=1

# 这是是否把 LLM 调试日志同时打印到控制台。
# 配置方法：`1` 表示打印，`0` 表示不打印。
ISOFTDEVAGENTS_AGENT_DEBUG_LLM_LOG_TO_CONSOLE=0

# 这是单次记录 LLM 输入时最多保留多少字符。
# 配置方法：值越大，日志越完整，但日志文件也越大。
ISOFTDEVAGENTS_AGENT_DEBUG_LLM_INPUT_LIMIT=12000

# 这是单次记录 LLM 输出时最多保留多少字符。
# 配置方法：值越大，日志越完整，但日志文件也越大。
ISOFTDEVAGENTS_AGENT_DEBUG_LLM_OUTPUT_LIMIT=12000

# 这是阶段切换前等待旧 Agent 停干净的时间，单位是秒。
# 配置方法：如果你希望更早暴露停机问题，就保持较小；如果你想更耐等，可以调大。
ISOFTDEVAGENTS_AGENT_SHUTDOWN_WAIT_SECONDS=30

# 这是 CrewAI 自带 tracing 的开关。
# 配置方法：Docker 中默认建议关闭，减少无关输出。
CREWAI_TRACING_ENABLED=false

# 这是容器里 LLM 调试日志文件路径。
# 配置方法：填写容器内部一个有写权限的位置，通常放到 `/app/agent/platform/log` 下。
ISOFTDEVAGENTS_AGENT_DEBUG_LLM_LOG_FILE=/app/agent/platform/log/llm-debug.log

# 这是视觉相关 Agent 使用的第三方密钥。
# 配置方法：不用可以留空，需要时再填真实值。
VISION_AGENT_API_KEY=

# 这是 Serper 搜索接口密钥。
# 配置方法：如果你希望 Agent 能联网搜索，请填真实密钥。
SERPER_API_KEY=

# 这是图片相关模型使用的密钥。
# 配置方法：如果不用图片相关能力，可以先留空。
ISOFTDEVAGENTS_IMAGE_LLM_API_KEY=

# 这是图片相关模型使用的接口地址。
# 配置方法：填写图片模型服务的 OpenAI 兼容根地址。
ISOFTDEVAGENTS_IMAGE_LLM_BASE_URL=https://api.modelverse.cn/v1

# 这是图片相关模型名称。
# 配置方法：填写图片模型服务支持的模型名。
ISOFTDEVAGENTS_IMAGE_LLM_MODEL=moonshot/kimi-k2.5

# 这是 pip 安装依赖时使用的 Python 包镜像源。
# 配置方法：如果你在国内网络环境，建议用速度更快的镜像源。
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# 这是 uv 安装依赖时使用的默认镜像源。
# 配置方法：建议和 PIP_INDEX_URL 保持同一个镜像站。
UV_DEFAULT_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple

# 这是 uv 发起 HTTP 下载时的超时时间，单位是秒。
# 配置方法：如果构建时经常下载超时，可以调大。
UV_HTTP_TIMEOUT=600

# 这是 npm 使用的包镜像源。
# 配置方法：如果你在国内网络环境，建议使用更快的 npm 镜像。
NPM_CONFIG_REGISTRY=https://registry.npmmirror.com

# 这是 pnpm 下载依赖时的超时时间，单位是毫秒。
# 配置方法：如果前端依赖经常下载超时，可以调大。
PNPM_FETCH_TIMEOUT=600000

# 这是 pnpm 下载依赖失败后的重试次数。
# 配置方法：网络不稳定时可以适当调大。
PNPM_FETCH_RETRIES=5
