# 接口注释：
# 这是「单机服务器正式部署」用的环境变量模板。
#
# 使用方法：
#   cp .env.server.example .env
#   # 改掉里面的占位值
#   docker compose up -d --build
#
# 为什么必须叫 .env：
# docker compose 会自动读取【compose 文件所在目录】下的 .env，
# 用它做 docker-compose.yml 里 ${VAR} 的变量插值。
# 所以只要文件名是 .env 且放在仓库根目录，就不需要再带 --env-file。
#
# 和 deploy/docker/backend.env.example（本地 Docker 测试用）的区别：
# 1. 依赖镜像源改回官方源（服务器在海外，走国内镜像会超时）
# 2. 打开 https profile，由 caddy 占住对外的 80/443，web 退到本机 9080
# 3. 数据库口令必须自己改，不能沿用默认的 isoftdev
# 4. 按小内存机器预设了并发旋钮
#
# 注意事项：
# - 这个文件只用于 compose 变量插值，不会被后端进程直接读取。
#   后端自己读的是 agent/platform/.env 和 agent/platform/.env.local，两者互不干扰。
# - 不要加引号、不要写 shell 展开（如 $HOME），compose 不做 shell 解析。
# - .env 已被 .gitignore 忽略，不会误提交；也请确保 rsync 时排除它，
#   否则带 --delete 的同步会把服务器上的 .env 删掉。

# ============================================================
# 1. 对外端口 / 网络绑定
# ============================================================

# 这是前端 web 容器发布到宿主机的端口。
# 配置方法：保持 9080，**仅供服务器本机调试**（curl http://127.0.0.1:9080/）。
# 公网流量一律走 caddy 的 80/443，web 不再直接对外，否则会和 caddy 抢 80 端口。
ISOFTDEVAGENTS_WEB_PORT=9080

# 这是 web 调试端口绑定的地址。
# 配置方法：保持 127.0.0.1。改成 0.0.0.0 等于把一个绕过 HTTPS 的入口挂到公网上。
ISOFTDEVAGENTS_WEB_BIND_HOST=127.0.0.1

# 这是后端调试端口绑定的地址。
# 配置方法：保持 127.0.0.1，只允许在服务器本机 curl 后端；前端走容器内网，不受影响。
ISOFTDEVAGENTS_BACKEND_BIND_HOST=127.0.0.1
ISOFTDEVAGENTS_BACKEND_PORT=9010

# 这是 PostgreSQL 端口绑定的地址。
# 配置方法：保持 127.0.0.1。改成 0.0.0.0 等于把数据库挂到公网上。
ISOFTDEVAGENTS_PG_BIND_HOST=127.0.0.1
ISOFTDEVAGENTS_PG_PORT=5432

# ============================================================
# 1.5 HTTPS / 证书（caddy）
# ============================================================
#
# 背景：
# caddy 容器占住宿主机 80/443，自动向 Let's Encrypt 申请证书并自动续期，
# 然后反代到内网的 web:80。配置见 deploy/docker/Caddyfile。
#
# 前置条件（缺一样证书都签不出来）：
# 1. 域名的 A 记录已经指向这台机器的公网 IP
# 2. 系统防火墙放通 80/tcp 和 443/tcp
# 3. 云厂商安全组也放通 443/tcp —— 这一层只能在控制台操作，最容易漏

# 这是打开 caddy 服务的开关。
# 配置方法：填 https。docker compose 会读这个变量决定启用哪些 profile，
# 只有它被设成 https，caddy 才会随 `docker compose up -d` 一起起来。
# 想临时退回纯 HTTP：把这一行注释掉，再 docker compose stop caddy。
COMPOSE_PROFILES=https

# 这是要签发证书的域名。
# 配置方法：填裸域即可，例如 gmonkey.ai。
# 想同时覆盖 www，先确认 www 的 A 记录已生效，再改 Caddyfile（文件末尾有步骤）。
# 注意：证书里写了几个域名就会逐个验证，有一个解析不到就整次签发失败。
ISOFTDEVAGENTS_SITE_DOMAIN=gmonkey.ai

# 这是 Let's Encrypt 用来发证书到期提醒的邮箱。
# 配置方法：必须换成你自己的真实邮箱。留空的话 caddy 容器会直接启动失败——
# 这是故意设计成这样的，免得配错了却要等证书快过期才发现。
ISOFTDEVAGENTS_ACME_EMAIL=CHANGE-ME@example.com

# ============================================================
# 2. 数据库
# ============================================================

# 这是 PostgreSQL 的密码。
# 配置方法：必须换成你自己的强口令，并且和下面 DATABASE_URL 里的密码保持一致。
POSTGRES_PASSWORD=CHANGE-ME-strong-password

# 这是后端连接数据库用的完整 DSN。
# 配置方法：把 CHANGE-ME-strong-password 换成上面那一行同样的值；主机名固定是 postgres（容器名）。
DATABASE_URL=postgresql://isoftdev:CHANGE-ME-strong-password@postgres:5432/isoftdev

# ============================================================
# 2.5 小内存机器专用旋钮（1~2G 内存必须保持这组值）
# ============================================================
#
# 背景：
# 每个 Agent 是一个独立子进程，起来就要把整套 CrewAI + LiteLLM 加载一遍，
# 单个子进程常驻内存约 500~800MB。
# 代码默认允许 8 个并发工作流，那是给大内存机器准备的，
# 在 1.6G 机器上开第二个 Agent 就会被 OOM killer 杀掉。

# 这是最多允许几条工作流同时跑。
# 配置方法：1~2G 内存填 1；4G 可以试 2；8G 以上再往上加。
ISOFTDEVAGENTS_MAX_CONCURRENT_WORKFLOWS=1

# 这是 Agent 专用线程池的大小。
# 配置方法：跟上面的并发工作流数配套，小内存机器填 2 就够。
ISOFTDEVAGENTS_AGENT_EXECUTOR_MAX_WORKERS=2

# 这是数据库连接池的常驻/上限连接数。
# 配置方法：每条连接在 PostgreSQL 侧都是一个独立进程，
# 小内存机器填 2/10；默认的 10/50 会白占一两百 MB。
ISOFTDEVAGENTS_PG_POOL_MIN=2
ISOFTDEVAGENTS_PG_POOL_MAX=10

# 这是前端构建时给 Node/V8 的堆上限。
# 配置方法：1~2G 内存机器填 --max-old-space-size=1536，
# 让 rollup 到点就 GC 而不是一路涨到被 OOM killer 杀掉。
# 大内存机器可以留空，用 Node 默认行为。
WEB_BUILD_NODE_OPTIONS=--max-old-space-size=1536

# ============================================================
# 3. 大模型配置（占位，Agent 功能依赖这里）
# ============================================================

# 这是平台统一使用的主大模型接口地址。
# 配置方法：填兼容 OpenAI API 的根地址，通常以 /v1 结尾。
ISOFTDEVAGENTS_LLM_BASE_URL=https://api.modelverse.cn/v1

# 这是平台统一使用的主大模型名称。
# 配置方法：填服务商支持的模型名。
ISOFTDEVAGENTS_LLM_MODEL=openai/gpt-5.4

# 这是平台统一使用的主大模型密钥。
# 配置方法：改成真实密钥。当前是占位值，五个 Agent 在填之前都无法真正工作。
ISOFTDEVAGENTS_LLM_API_KEY=REPLACE-WITH-YOUR-REAL-KEY

# ============================================================
# 4. Agent 开关
# ============================================================

ISOFTDEVAGENTS_ENABLE_REAGENT=1
ISOFTDEVAGENTS_ENABLE_ARCH_AGENT=1
ISOFTDEVAGENTS_ENABLE_UI_AGENT=1
ISOFTDEVAGENTS_ENABLE_CODING_AGENT=1
ISOFTDEVAGENTS_ENABLE_TEST_AGENT=1

# ============================================================
# 5. 超时（秒）
# ============================================================

ISOFTDEVAGENTS_AGENT_TIMEOUT=3600
ISOFTDEVAGENTS_ANALYSIS_AGENT_TIMEOUT=3600
ISOFTDEVAGENTS_GENERATION_AGENT_TIMEOUT=3600
ISOFTDEVAGENTS_ARCHITECTURE_AGENT_TIMEOUT=3600
ISOFTDEVAGENTS_UI_AGENT_TIMEOUT=3600
ISOFTDEVAGENTS_CODING_AGENT_TIMEOUT=3600
ISOFTDEVAGENTS_TEST_AGENT_TIMEOUT=3600
ISOFTDEVAGENTS_AGENT_SHUTDOWN_WAIT_SECONDS=30

# ============================================================
# 6. 日志与调试
# ============================================================

ISOFTDEVAGENTS_DELETE_LOCAL_FILES_AFTER_PERSIST=0
ISOFTDEVAGENTS_AGENT_DEBUG_STDIO=1
ISOFTDEVAGENTS_AGENT_DEBUG_LLM_IO=1
ISOFTDEVAGENTS_AGENT_DEBUG_LLM_LOG_TO_FILE=1
ISOFTDEVAGENTS_AGENT_DEBUG_LLM_LOG_TO_CONSOLE=0
ISOFTDEVAGENTS_AGENT_DEBUG_LLM_INPUT_LIMIT=12000
ISOFTDEVAGENTS_AGENT_DEBUG_LLM_OUTPUT_LIMIT=12000
CREWAI_TRACING_ENABLED=false

# ============================================================
# 7. 可选第三方密钥
# ============================================================

VISION_AGENT_API_KEY=
SERPER_API_KEY=
ISOFTDEVAGENTS_IMAGE_LLM_API_KEY=
ISOFTDEVAGENTS_IMAGE_LLM_BASE_URL=https://api.modelverse.cn/v1
ISOFTDEVAGENTS_IMAGE_LLM_MODEL=moonshot/kimi-k2.5

# ============================================================
# 8. 构建期镜像源（关键：海外服务器必须用官方源）
# ============================================================

# 这是 pip 安装依赖时使用的包索引。
# 配置方法：海外服务器用官方 PyPI；如果这台机换到国内，再改成清华源。
PIP_INDEX_URL=https://pypi.org/simple
UV_DEFAULT_INDEX=https://pypi.org/simple
UV_HTTP_TIMEOUT=600

# 这是 npm/pnpm 使用的包镜像源。
# 配置方法：海外服务器用官方 registry。
NPM_CONFIG_REGISTRY=https://registry.npmjs.org
PNPM_FETCH_TIMEOUT=600000
PNPM_FETCH_RETRIES=5
