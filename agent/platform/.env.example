# 接口注释：
# 这是后端平台的示例环境变量文件。
# 如果你主要是运行 `agent/platform` 这个后端服务，建议优先参考这份模板。

# 这是平台统一使用的主大模型接口地址。
# 配置方法：填写兼容 OpenAI API 的根地址，通常要以 `/v1` 结尾。
ISOFTDEVAGENTS_LLM_BASE_URL=https://api.modelverse.cn/v1

# 这是平台统一使用的主大模型名称。
# 配置方法：填写服务商支持的模型名，例如 `gpt-5.4`。
ISOFTDEVAGENTS_LLM_MODEL=gpt-5.4

# 这是平台统一使用的主大模型密钥。
# 配置方法：替换成你自己的真实密钥。
ISOFTDEVAGENTS_LLM_API_KEY=replace-with-your-key

# 这是是否启用 Requirements Agent。
# 配置方法：`1` 表示启用，`0` 表示禁用。
ISOFTDEVAGENTS_ENABLE_REAGENT=1

# 这是是否启用 Architecture Agent。
# 配置方法：`1` 表示启用，`0` 表示禁用。
ISOFTDEVAGENTS_ENABLE_ARCH_AGENT=1

# 这是统一的 Agent 运行总超时时间，单位是秒。
# 配置方法：如果你希望所有 Agent 都默认更耐等，可以把这个值调大。
ISOFTDEVAGENTS_AGENT_TIMEOUT=3600

# 这是零残留开关。
# 配置方法：`1` 表示“成功持久化后尽量删除本地文件”，`0` 表示保留本地文件。
ISOFTDEVAGENTS_DELETE_LOCAL_FILES_AFTER_PERSIST=0

# 这是是否把 Agent 的标准输出和标准错误打印到控制台。
# 配置方法：本地排查问题建议设成 `1`。
ISOFTDEVAGENTS_AGENT_DEBUG_STDIO=1

# 这是是否记录 LLM 输入输出日志。
# 配置方法：`1` 表示记录，`0` 表示不记录。
ISOFTDEVAGENTS_AGENT_DEBUG_LLM_IO=1

# 这是是否把 LLM 调试日志写入文件。
# 配置方法：本地排查建议设成 `1`；如果你不想落盘，可以设成 `0`。
ISOFTDEVAGENTS_AGENT_DEBUG_LLM_LOG_TO_FILE=1

# 这是是否把 LLM 调试日志同时打印到控制台。
# 配置方法：`1` 表示打印，`0` 表示只写文件或完全关闭。
ISOFTDEVAGENTS_AGENT_DEBUG_LLM_LOG_TO_CONSOLE=0

# 这是 LLM 调试日志文件路径。
# 配置方法：填写一个当前进程有写权限的绝对路径。
ISOFTDEVAGENTS_AGENT_DEBUG_LLM_LOG_FILE=/absolute/path/to/agent/platform/log/llm-debug.log

# 这是单次记录 LLM 输入时最多保留多少字符。
# 配置方法：值越大，日志越完整，但日志文件也会更大。
ISOFTDEVAGENTS_AGENT_DEBUG_LLM_INPUT_LIMIT=12000

# 这是单次记录 LLM 输出时最多保留多少字符。
# 配置方法：值越大，日志越完整，但日志文件也会更大。
ISOFTDEVAGENTS_AGENT_DEBUG_LLM_OUTPUT_LIMIT=12000

# 这是 Requirements Agent 使用的 Python 解释器路径。
# 配置方法：填写 Requirements Agent 虚拟环境里的 python 绝对路径。
ISOFTDEVAGENTS_REAGENT_PYTHON_BIN=/absolute/path/to/python

# 这是视觉相关 Agent 可能用到的第三方接口密钥。
# 配置方法：如果你没有接这个能力，可以先留空。
VISION_AGENT_API_KEY=replace-with-your-key

# 这是搜索增强能力使用的 Serper 密钥。
# 配置方法：如果你希望 Agent 做联网搜索，请填真实密钥。
SERPER_API_KEY=replace-with-your-key

# 这是 Architecture Agent 使用的 Python 解释器路径。
# 配置方法：填写 Architecture Agent 虚拟环境里的 python 绝对路径。
ISOFTDEVAGENTS_ARCH_AGENT_PYTHON_BIN=/absolute/path/to/python

# 这是 Coding Agent 所在虚拟环境的 site-packages 路径。
# 配置方法：填写 Coding Agent 虚拟环境里的 site-packages 绝对路径。
ISOFTDEVAGENTS_CODING_AGENT_SITE_PACKAGES=/absolute/path/to/python

# 这是图片相关模型的密钥。
# 配置方法：如果你会用到图片生成或视觉理解能力，就填真实密钥。
ISOFTDEVAGENTS_IMAGE_LLM_API_KEY=replace-with-your-key

# 这是图片相关模型的接口地址。
# 配置方法：填写图片模型服务的 OpenAI 兼容根地址。
ISOFTDEVAGENTS_IMAGE_LLM_BASE_URL=https://api.modelverse.cn/v1

# 这是图片相关模型名称。
# 配置方法：填写图片模型服务支持的模型名。
ISOFTDEVAGENTS_IMAGE_LLM_MODEL=moonshot/kimi-k2.5
